package-as: StatCompass

# The addon lives in the StatCompass/ subfolder; the repository root holds tools, tests and docs.
move-folders:
  StatCompass/StatCompass: StatCompass

# Generated by tools/generate_changelog.py from the bilingual pairs in changelog/.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - .claude
  - AGENTS.md
  - CLAUDE.md
  - README.md
  - LICENSE
  - assets
  - changelog
  - dist
  - docs
  - tests
  - tools
